{
  "name": "bank-detect-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/database.ts seed",
    "reset": "node --env-file-if-exists=.env scripts/database.ts reset",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "docs:examples": "node scripts/examples.ts",
    "nessie:smoke": "node --env-file-if-exists=.env scripts/nessie-smoke.ts",
    "nessie:seed": "node --env-file-if-exists=.env scripts/nessie-seed.ts",
    "analyst:smoke": "node --env-file-if-exists=.env scripts/analyst-smoke.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "@types/node": "^24.10.0", "typescript": "~5.9.3" }
}
