# Development-only fictional banking demo. Never enable in production.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
# Exact browser origin; serve/proxy the dashboard and API from this same origin.
APP_ORIGIN=http://127.0.0.1:3001
DATABASE_PATH=./data/demo.sqlite
# Set a random secret of at least 24 characters to enable administrator login.
DEMO_ADMIN_KEY=
SECURITY_WINDOW_MS=300000
SECURITY_BURST_WINDOW_MS=2000
SECURITY_BURST_LIMIT=8
SECURITY_THROTTLE_SCORE=55
SECURITY_BLOCK_SCORE=90
# Optional explanations only. Both values are required to enable network calls.
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=
