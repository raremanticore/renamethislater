# Development-only fictional banking demo. Never enable in production.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
# Exact browser origin when starting the backend separately. dev:all sets this automatically.
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/demo.sqlite
# local = fictional fixtures; nessie = real requests to our Nessie sandbox, never fallback.
BANKING_PROVIDER=local
NESSIE_API_KEY=
NESSIE_API_BASE_URL=https://prod-api.nessieisreal.com
# Server user ID -> public account alias -> YOUR owned Nessie sandbox account ID.
# Replace placeholders only in the ignored .env file. Each upstream ID must have one owner.
NESSIE_ACCOUNT_MAP='{}'
# Example: NESSIE_ACCOUNT_MAP='{"user-alice":{"acc-alice-checking":"YOUR_SANDBOX_ACCOUNT_ID"}}'
# Set a random secret of at least 24 characters to enable administrator login.
DEMO_ADMIN_KEY=
SECURITY_WINDOW_MS=300000
SECURITY_BURST_WINDOW_MS=2000
SECURITY_BURST_LIMIT=8
SECURITY_THROTTLE_SCORE=55
SECURITY_BLOCK_SCORE=90
# Optional explanations/analyst only. Both values enable server-side OpenAI calls.
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=
